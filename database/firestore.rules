rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.active == true;
    }

    function isRole(role) {
      return isAdmin() &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == role;
    }

    function hasAnyRole(roles) {
      return isAdmin() &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in roles;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Default deny. Every collection must have an explicit rule.
    match /{document=**} {
      allow read, write: if false;
    }



    // Admin directory. Bootstrap these documents manually from Firebase Console
    // or trusted server tooling. Clients cannot create/modify their own admin access.
    match /admin_users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // User profile: user can read/update only their own non-privileged profile.
    // Privileged fields such as role must be controlled by trusted backend/Admin SDK.
    match /users/{uid} {
      allow read: if isSelf(uid) || hasAnyRole(['SUPER_ADMIN', 'SUPPORT', 'EVENT_ADMIN', 'FINANCE', 'AUDITOR']);
      allow create: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Events.
    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isRole('SUPER_ADMIN');
    }

    // Payment intents: users can create their own pending intent.
    // Payment state cannot be promoted by the client.
    match /payment_intents/{intentId} {
      // Admin console may create a payment intent in REQUIRES_PAYMENT state.
      // A normal signed-in user may create only their own PENDING intent.
      allow read: if signedIn() &&
        (resource.data.user_id == request.auth.uid ||
         hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'AUDITOR']));

      // Payment intents are created by the trusted Apps Script backend.
      // The browser may read authorized intents, but cannot create or alter
      // payment intent state directly.
      allow create, update, delete: if false;
    }

    // Orders: clients can create/read their own orders; payment/ticket state
    // is trusted-backend controlled.
    match /orders/{orderId} {
      allow read: if signedIn() &&
        (resource.data.user_id == request.auth.uid ||
         hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'SUPPORT', 'AUDITOR']));
      allow create: if signedIn() &&
        request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Transactions: trusted-backend written ledger. Authorized operational roles
    // may read reconciliation data; end users may read only their own transactions.
    match /transactions/{transactionId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'AUDITOR']) ||
        (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // Payment ledger: read only for authorized users. No client writes.
    match /payment_ledger/{ledgerId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'AUDITOR']) ||
        (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // Provider/webhook events: never client-writable.
    match /webhook_events/{webhookId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'AUDITOR']);
      allow write: if false;
    }

    // Verification results: never client-writable.
    match /payment_verifications/{verificationId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'AUDITOR']) ||
        (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // Tickets: client may read their own ticket. Creation/status changes are trusted backend only.
    match /tickets/{ticketId} {
      allow read: if signedIn() &&
        (resource.data.user_id == request.auth.uid ||
         hasAnyRole(['SUPER_ADMIN', 'EVENT_ADMIN', 'SUPPORT', 'AUDITOR']));
      allow create, update, delete: if false;
    }

    // Checkout sessions are trusted-backend generated. Client writes are forbidden.
    match /checkout_sessions/{checkoutId} {
      allow read: if signedIn() &&
        (resource.data.created_by == request.auth.uid ||
         hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'SUPPORT', 'AUDITOR']));
      allow create, update, delete: if false;
    }

    // Reconciliation.
    match /reconciliation/{recordId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'AUDITOR']);
      allow write: if false;
    }

    // Audit logs are immutable to clients.
    match /audit_logs/{auditId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'AUDITOR', 'FINANCE']);
      allow write: if false;
    }

    // Sandbox is intentionally isolated from production.
    match /sandbox_runs/{runId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'FINANCE', 'EVENT_ADMIN', 'AUDITOR']);
      allow create: if hasAnyRole(['SUPER_ADMIN', 'EVENT_ADMIN'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.production == false
        && request.resource.data.real_bank_called == false;
      allow update, delete: if false;
    }

    // Failure tests are non-production and cannot affect payment/tickets.
    match /failure_tests/{testId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'AUDITOR', 'FINANCE']);
      allow create: if hasAnyRole(['SUPER_ADMIN', 'EVENT_ADMIN'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.production == false
        && request.resource.data.real_bank_called == false;
      allow update, delete: if false;
    }

    // Operational health checks.
    match /health_checks/{checkId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'AUDITOR', 'FINANCE']);
      allow create: if hasAnyRole(['SUPER_ADMIN', 'EVENT_ADMIN'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.production == false
        && request.resource.data.bank_called == false;
      allow update, delete: if false;
    }

    // Final audit records are evidence only; they cannot grant production approval.
    match /final_audits/{auditId} {
      allow read: if hasAnyRole(['SUPER_ADMIN', 'AUDITOR', 'FINANCE']);
      allow create: if hasAnyRole(['SUPER_ADMIN', 'AUDITOR'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.production == false
        && request.resource.data.bank_called == false
        && request.resource.data.approval == false;
      allow update, delete: if false;
    }

    // Any future collections remain denied until explicitly reviewed.
  }
}
