    "client_cannot_assign_privileged_role": true,
    "client_cannot_execute_refund_or_capture": true,
    "client_cannot_mark_audit_trusted": true,
    "firebase_project_binding": "beepay-2c2dc",
    "sandbox_never_calls_real_bank": true,
    "sandbox_cannot_activate_production_ticket": true,
    "failure_tests_are_non_production": true,
    "health_checks_non_production": true,
    "final_audit_is_non_production": true
